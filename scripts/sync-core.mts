// Copies packages/core/src into supabase/functions/_shared/core for the Edge Functions (02 §3:
// Supabase bundles only what is under supabase/functions). Deno needs explicit file paths, so
// relative imports get their `.ts` (or `/index.ts`); bare imports (zod, mathjs, katex,
// @supabase/supabase-js) resolve through each function's deno.json import map. Tests are skipped.
// Usage: pnpm sync:core          write the copy
//        pnpm sync:core --check  fail if the copy is out of date (pnpm check, CI)
import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";

const SRC = resolve("packages/core/src");
const OUT = resolve("supabase/functions/_shared/core");
const HEADER = "// Generated by scripts/sync-core.mts from packages/core/src. Do not edit; run `pnpm sync:core`.\n";
const check = process.argv.includes("--check");

function walk(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    const full = join(dir, name);
    if (statSync(full).isDirectory()) return walk(full);
    return name.endsWith(".ts") && !name.endsWith(".test.ts") ? [full] : [];
  });
}

/** `./x` → `./x.ts` or `./x/index.ts`, resolved against the importing file. */
function rewrite(code: string, file: string): string {
  return code.replace(/(from\s+|import\s*\(\s*)(["'])(\.{1,2}\/[^"']+)\2/g, (whole, lead, quote, spec: string) => {
    if (spec.endsWith(".ts")) return whole;
    const base = resolve(dirname(file), spec);
    const target = existsSync(`${base}.ts`)
      ? `${spec}.ts`
      : existsSync(join(base, "index.ts"))
        ? `${spec}/index.ts`
        : null;
    if (!target) throw new Error(`${relative(SRC, file)}: can't resolve "${spec}"`);
    return `${lead}${quote}${target}${quote}`;
  });
}

const expected = new Map<string, string>();
for (const file of walk(SRC)) {
  expected.set(join(OUT, relative(SRC, file)), HEADER + rewrite(readFileSync(file, "utf8"), file));
}

const existing = existsSync(OUT) ? walk(OUT) : [];
const stale = existing.filter((f) => !expected.has(f));
const changed = [...expected].filter(([f, body]) => !existsSync(f) || readFileSync(f, "utf8") !== body).map(([f]) => f);

if (check) {
  if (stale.length || changed.length) {
    console.error("✗ supabase/functions/_shared/core is out of date with packages/core. Run `pnpm sync:core`.");
    for (const f of [...changed, ...stale]) console.error(`    ${relative(process.cwd(), f)}`);
    process.exit(1);
  }
  console.log(`✓ _shared/core matches packages/core (${expected.size} files)`);
} else {
  for (const f of stale) rmSync(f);
  for (const [f, body] of expected) {
    mkdirSync(dirname(f), { recursive: true });
    if (!existsSync(f) || readFileSync(f, "utf8") !== body) writeFileSync(f, body);
  }
  console.log(
    `✓ synced ${expected.size} files to supabase/functions/_shared/core (${changed.length} changed, ${stale.length} removed)`,
  );
}
