{
  "name": "ifiok-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:dsl": "vitest run packages/core/src/dsl/schema.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:dsl && pnpm sync:core --check && pnpm test:db:local && pnpm format:check",
    "db:types": "supabase gen types typescript --linked --schema public > packages/core/src/db/types.ts",
    "test:db:local": "node scripts/db-test.mts",
    "test:db:remote": "node scripts/db-test-remote.mts",
    "db:push": "supabase db push --linked",
    "test:integration": "vitest run --config vitest.integration.mts",
    "sync:core": "node scripts/sync-core.mts",
    "deploy:worker": "pnpm sync:core && supabase functions deploy worker --use-api",
    "check:worker": "cd supabase/functions/worker && pnpm dlx deno@2.5.4 check --config deno.json index.ts",
    "setup:worker": "node scripts/setup-worker.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hookform/resolvers": "5.9.1",
    "@ifiok/core": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "katex": "^0.19.0",
    "mathjs": "^15.2.0",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.90.0",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgtap": "^0.0.9",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
