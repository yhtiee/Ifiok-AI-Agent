# Copy to .env.local and fill in. Validated at boot by lib/env/schema.ts (02 §9).
# Never commit real values. Server-only secrets must never get a NEXT_PUBLIC_ prefix.

# Required now
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional now; the ticket in brackets makes each one required
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRIVACY_EMAIL=               # shown on /privacy
NEXT_PUBLIC_MINORS_EMAIL=                # shown on the under-18 page (08 §3)
SUPABASE_SERVICE_ROLE_KEY=            # [P0-04] sb_secret_... (server only)
SUPABASE_PROJECT_REF=                 # for `pnpm db:types`
AUTH_EMAIL_CODES=false                # true once Resend SMTP is connected in Supabase
AUTH_DEV_SIGN_IN=true
INTERNAL_FUNCTION_SECRET=              # [P1-01] same value as `supabase secrets set INTERNAL_FUNCTION_SECRET=…`
RESEND_API_KEY=                       # [P0-04]
TURNSTILE_SITE_KEY=                   # [P0-04]
TURNSTILE_SECRET_KEY=                 # [P0-04]
GEMINI_API_KEY=                       # [P0-10]
ANTHROPIC_API_KEY=                    # [P0-10]
SENTRY_DSN=                           # [P0-14]
POSTHOG_KEY=                          # [P0-14]
VAPID_PUBLIC_KEY=                     # [P1-12]
VAPID_PRIVATE_KEY=                    # [P1-12]
PAYSTACK_SECRET_KEY=                  # [P2-03]
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=      # [P2-03]
GROQ_API_KEY=                         # [P3]
